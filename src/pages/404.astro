---
import Layout from '../layouts/Layout.astro'

const pageTitle = 'Page Not Found — Jorge GB'
const pageDescription = 'The page you are looking for does not exist on jorgegb.dev.'
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl="https://jorgegb.dev/404" robotsContent="noindex, follow">
    <header class="bg-surface border-b border-gray-200 sticky top-0 z-50">
        <div class="site-container flex justify-between items-center py-3">
            <div class="flex items-center gap-3">
                <img
                    src="/logo.svg"
                    alt="JGB Logo"
                    width="40"
                    height="40"
                    class="w-10 h-10"
                />
                <span class="text-xl font-bold">jorgegb.dev</span>
            </div>

            <div class="flex items-center gap-4">
                <nav class="flex items-center gap-5">
                    <ul class="flex items-center gap-4 whitespace-nowrap">
                        <li><a href="/" class="hover:underline transition-colors text-sm">Home</a></li>
                    </ul>
                </nav>

                <button id="theme-toggle" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Toggle theme">
                    <svg
                        id="sun-icon"
                        class="hidden dark:block"
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <svg
                        id="moon-icon"
                        class="block dark:hidden"
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main id="main" class="flex-1">
        <section class="section bg-muted-surface">
            <div class="site-container text-center py-16">
                <p class="font-mono text-sm text-secondary-text mb-1">
                    <span class="text-primary-blue">$</span> jorgegb.dev --status
                </p>
                <h1 class="section-title">404 — Page Not Found</h1>
                <p class="text-secondary-text mb-8">
                    The page you are looking for does not exist or was moved.
                </p>
                <div class="text-center section-buttons">
                    <a href="/" class="btn btn-primary">Back to Home</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-surface border-t border-gray-200 py-4">
        <div class="site-container text-center">
            <p class="text-secondary-text">
                &copy; {new Date().getFullYear()} Jorge García Brizuela. All rights reserved.
            </p>
            <p class="text-secondary-text">
                Built with Astro and TypeScript
            </p>
        </div>
    </footer>
</Layout>
