---
import Layout from '../layouts/Layout.astro'
import { fetchGitHubRepos, fetchNpmPackages } from '../lib/projects'

const repos = await fetchGitHubRepos()
const packages = await fetchNpmPackages()

function formatDownloads(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`
  return String(n)
}

const pageTitle = 'Projects — Jorge GB'
const pageDescription = 'Open-source GitHub repositories and npm packages by Jorge García Brizuela.'

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects',
  url: 'https://jorgegb.dev/projects',
}
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl="https://jorgegb.dev/projects" jsonLd={collectionLd}>
    <header class="bg-surface border-b border-gray-200 sticky top-0 z-50">
        <div class="container flex justify-between items-center py-3">
            <div class="flex items-center gap-3">
                <img
                    src="/logo.svg"
                    alt="JGB Logo"
                    class="w-10 h-10"
                />
                <span class="text-xl font-bold">jorgegb.dev</span>
            </div>

            <div class="flex items-center gap-4">
                <nav class="hidden lg:flex items-center gap-5">
                    <ul class="flex items-center gap-4 whitespace-nowrap">
                        <li><a href="/" class="hover:underline transition-colors text-sm">Home</a></li>
                        <li><a href="/publications" class="hover:underline transition-colors text-sm">Publications</a></li>
                        <li><a href="/projects" class="hover:underline transition-colors text-sm">Projects</a></li>
                        <li><a href="/blog" class="hover:underline transition-colors text-sm">Blog</a></li>
                        <li><a href="/wishlist" class="hover:underline transition-colors text-sm">Wishlist</a></li>
                    </ul>
                </nav>

                <button id="theme-toggle" class="p-2 min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Toggle theme">
                    <svg
                        id="sun-icon"
                        class="hidden dark:block"
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <svg
                        id="moon-icon"
                        class="block dark:hidden"
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>

                <button
                    id="mobile-menu-btn"
                    class="lg:hidden p-2 min-w-[44px] min-h-[44px] flex items-center justify-center"
                    aria-label="Toggle menu"
                    aria-expanded="false"
                    aria-controls="mobile-menu-dropdown"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
        <div id="mobile-menu-dropdown" class="lg:hidden hidden absolute top-full left-0 right-0 bg-surface border-b border-gray-200">
            <ul class="flex flex-col gap-4 p-4">
                <li><a href="/" class="block hover:underline transition-colors">Home</a></li>
                <li><a href="/publications" class="block hover:underline transition-colors">Publications</a></li>
                <li><a href="/projects" class="block hover:underline transition-colors">Projects</a></li>
                <li><a href="/blog" class="block hover:underline transition-colors">Blog</a></li>
                <li><a href="/wishlist" class="block hover:underline transition-colors">Wishlist</a></li>
            </ul>
        </div>
    </header>

    <main id="main" class="flex-1">
        <section id="projects" class="section bg-surface">
            <div class="container">
                <h2 class="section-title">Projects</h2>

                {repos.length > 0 && (
                    <div>
                        <h3 class="text-lg font-semibold mb-4 text-secondary-text">GitHub Projects</h3>
                        <div class="grid md:grid-cols-2 gap-4">
                            {repos.map((repo) => (
                                <div class="card">
                                    <p class="font-mono text-sm text-secondary-text mb-1">
                                        <span class="text-primary-blue">$</span> gh repo {repo.name}
                                        {repo.stargazersCount > 0 && (
                                            <span class="float-right text-yellow-500">★ {repo.stargazersCount}</span>
                                        )}
                                    </p>
                                    <p class="mb-3">{repo.description ?? 'No description'}</p>
                                    <div class="flex items-center gap-2 mb-3">
                                        {repo.language && (
                                            <span class="text-xs font-mono text-secondary-text border border-gray-300 px-2 py-0.5">{repo.language}</span>
                                        )}
                                    </div>
                                    <a
                                        href={repo.htmlUrl}
                                        target="_blank"
                                        rel="noopener"
                                        class="text-primary-blue hover:underline font-mono text-sm"
                                    >
                                        View on GitHub →
                                    </a>
                                </div>
                            ))}
                        </div>
                    </div>
                )}

                {repos.length === 0 && (
                    <div class="card mb-8">
                        <p class="text-secondary-text">
                            Unable to load GitHub repositories. Check my
                            {' '}<a href="https://github.com/jorgitogb" target="_blank" rel="noopener" class="text-primary-blue hover:underline">GitHub profile</a>.
                        </p>
                    </div>
                )}

                {packages.length > 0 && (
                    <div class="mt-8">
                        <h3 class="text-lg font-semibold mb-4 text-secondary-text">npm Packages</h3>
                        <div class="grid md:grid-cols-2 gap-4">
                            {packages.map((pkg) => (
                                <div class="card">
                                    <p class="font-mono text-sm text-secondary-text mb-1">
                                        <span class="text-primary-blue">$</span> npm i {pkg.name}
                                        <span class="float-right text-green-500">↓ {formatDownloads(pkg.weeklyDownloads)}/wk</span>
                                    </p>
                                    <p class="mb-3">{pkg.description ?? 'No description'}</p>
                                    <p class="text-xs font-mono text-secondary-text mb-3">v{pkg.version}</p>
                                    {pkg.repositoryUrl && (
                                        <a
                                            href={pkg.repositoryUrl}
                                            target="_blank"
                                            rel="noopener"
                                            class="text-primary-blue hover:underline font-mono text-sm"
                                        >
                                            View on npm →
                                        </a>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>
                )}

                {packages.length === 0 && (
                    <div class="card mt-8">
                        <p class="text-secondary-text">
                            Unable to load npm packages. Check my
                            {' '}<a href="https://www.npmjs.com/~jorgegb" target="_blank" rel="noopener" class="text-primary-blue hover:underline">npm profile</a>.
                        </p>
                    </div>
                )}
            </div>
        </section>
    </main>

    <footer class="bg-surface border-t border-gray-200 py-4">
        <div class="container text-center">
            <p class="text-secondary-text">
                &copy; {new Date().getFullYear()} Jorge García Brizuela. All rights reserved.
            </p>
            <p class="text-secondary-text">
                Built with Astro and TypeScript
            </p>
        </div>
    </footer>
</Layout>

