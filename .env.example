# Linear API key — required for Linear MCP integration
# Get yours at: https://linear.app/settings/api
LINEAR_API_KEY=

# GitHub token — optional, for builds. Without it the site build uses the
# unauthenticated GitHub API quota (60 req/hour); when the quota is
# exhausted the Projects section deploys empty. With a token (no scopes
# needed for public data) the quota is 5000 req/hour.
# Get yours at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Build-time fetch timeout in ms (optional, default 8000).
PROJECTS_FETCH_TIMEOUT_MS=
